# TMDB API v3 key. Server-side only, never expose to the client.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Google OAuth credentials, used only to show name and avatar (nuxt-auth-utils).
# https://console.cloud.google.com/apis/credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Random 32+ character string used to sign and encrypt the session cookie.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
