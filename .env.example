# ============================================================================
# ENVIRONMENT VARIABLES FOR DEVELOPMENT AND DEPLOYMENT
# ============================================================================
# Copy this file to .env and fill in the values before running the project

# TMDB API v3 key. Server-side only, never expose to the client.
# Get it from: https://www.themoviedb.org/settings/api
# Required for: Movies database, search, cast/crew data, credits
NUXT_TMDB_API_KEY=

# Google OAuth credentials, used only to show name and avatar (nuxt-auth-utils).
# Get them from: https://console.cloud.google.com/apis/credentials
# Create a new OAuth 2.0 Client ID with:
# - Application type: Web application
# - Authorized redirect URIs: http://localhost:3000/auth/google (dev) + your production domain
# Note: Optional for development if you want to test without auth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Random 32+ character string used to sign and encrypt the session cookie.
# Generate one with: openssl rand -base64 32
# Required for: Session security, user authentication
NUXT_SESSION_PASSWORD=

# ============================================================================
# FOR CLOUDFLARE WORKERS DEPLOYMENT
# ============================================================================
# These variables must also be set in your Cloudflare Workers Dashboard:
# Settings → Environment variables → "Variables" section
# 
# If using GitHub Actions for automatic deployment:
# 1. Go to Settings → Secrets and variables → Actions
# 2. Add the same variables as repository secrets
# 3. Update .github/workflows/deploy.yml to use them
#
# Names must match exactly (case-sensitive): NUXT_TMDB_API_KEY, etc.
