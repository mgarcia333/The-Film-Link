{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-film-link",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "GAME_KV",
      // Create namespaces with:
      // wrangler kv namespace create GAME_KV --preview false
      // wrangler kv namespace create GAME_KV --preview true
      // Then replace "id" and "preview_id" below with the returned IDs
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  // Precomputes the daily challenge shortly after UTC midnight (05:00 UTC).
  // This avoids the first request paying the generation cost.
  // Safe to remove - challenge also generates lazily on first request.
  "triggers": {
    "crons": ["5 0 * * *"]
  }
}
