{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-film-link",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "GAME_KV",
      "id": "ed0ffa76858d4c419eb536f931139294",
      "preview_id": "d4dc68310ff0439485070e333bf95abd"
    }
  ],
  // Precomputes the daily challenge shortly after UTC midnight (05:00 UTC).
  // This avoids the first request paying the generation cost.
  // Safe to remove - challenge also generates lazily on first request.
  "triggers": {
    "crons": ["5 0 * * *"]
  }
}
