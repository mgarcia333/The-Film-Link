{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-film-link",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "the-film-link-cache",
      "database_id": "32fd21a8-aa1f-4c5c-af33-cbd2893498e9",
      "migrations_dir": "migrations"
    }
  ],
  // Precomputes the daily challenge shortly after UTC midnight (05:00 UTC).
  // This avoids the first request paying the generation cost.
  // Safe to remove - challenge also generates lazily on first request.
  "triggers": {
    "crons": ["5 0 * * *"]
  }
}
